From c1cb0e6a20124e8a4f955960496aa8a30385994a Mon Sep 17 00:00:00 2001
From: dic1911 <9561880+dic1911@users.noreply.github.com>
Date: Mon, 3 Aug 2026 22:21:38 +0800
Subject: [PATCH] fixbuild

---
 libavcodec/get_bits.h | 16 ++++++++--------
 libavcodec/golomb.h   |  2 +-
 libavformat/isom.h    |  2 +-
 libavutil/cpu.c       |  6 +++---
 4 files changed, 13 insertions(+), 13 deletions(-)

diff --git a/libavcodec/get_bits.h b/libavcodec/get_bits.h
index a22c9755ae..354adb64c8 100644
--- a/libavcodec/get_bits.h
+++ b/libavcodec/get_bits.h
@@ -293,8 +293,8 @@ static inline void skip_bits_long(GetBitContext *s, int n)
  */
 static inline int get_xbits(GetBitContext *s, int n)
 {
-    register int sign;
-    register int32_t cache;
+    int sign;
+    int32_t cache;
     OPEN_READER(re, s);
     av_assert2(n>0 && n<=25);
     UPDATE_CACHE(re, s);
@@ -307,8 +307,8 @@ static inline int get_xbits(GetBitContext *s, int n)
 
 static inline int get_xbits_le(GetBitContext *s, int n)
 {
-    register int sign;
-    register int32_t cache;
+    int sign;
+    int32_t cache;
     OPEN_READER(re, s);
     av_assert2(n>0 && n<=25);
     UPDATE_CACHE_LE(re, s);
@@ -321,7 +321,7 @@ static inline int get_xbits_le(GetBitContext *s, int n)
 
 static inline int get_sbits(GetBitContext *s, int n)
 {
-    register int tmp;
+    int tmp;
     OPEN_READER(re, s);
     av_assert2(n>0 && n<=25);
     UPDATE_CACHE(re, s);
@@ -336,7 +336,7 @@ static inline int get_sbits(GetBitContext *s, int n)
  */
 static inline unsigned int get_bits(GetBitContext *s, int n)
 {
-    register unsigned int tmp;
+    unsigned int tmp;
     OPEN_READER(re, s);
     av_assert2(n>0 && n<=25);
     UPDATE_CACHE(re, s);
@@ -357,7 +357,7 @@ static av_always_inline int get_bitsz(GetBitContext *s, int n)
 
 static inline unsigned int get_bits_le(GetBitContext *s, int n)
 {
-    register int tmp;
+    int tmp;
     OPEN_READER(re, s);
     av_assert2(n>0 && n<=25);
     UPDATE_CACHE_LE(re, s);
@@ -372,7 +372,7 @@ static inline unsigned int get_bits_le(GetBitContext *s, int n)
  */
 static inline unsigned int show_bits(GetBitContext *s, int n)
 {
-    register unsigned int tmp;
+    unsigned int tmp;
     OPEN_READER_NOSIZE(re, s);
     av_assert2(n>0 && n<=25);
     UPDATE_CACHE(re, s);
diff --git a/libavcodec/golomb.h b/libavcodec/golomb.h
index 5169a5a4c0..76be21912f 100644
--- a/libavcodec/golomb.h
+++ b/libavcodec/golomb.h
@@ -511,7 +511,7 @@ static inline int get_ur_golomb_jpegls(GetBitContext *gb, int k, int limit,
                 buf = 0;
             }
 
-            buf += ((SUINT)i << k);
+            buf += ((unsigned)i << k);
         } else if (esc_len && i == limit - 1) {
             buf = SHOW_UBITS(re, gb, esc_len);
             LAST_SKIP_BITS(re, gb, esc_len);
diff --git a/libavformat/isom.h b/libavformat/isom.h
index c7264defb6..e9d75dee6b 100644
--- a/libavformat/isom.h
+++ b/libavformat/isom.h
@@ -319,7 +319,7 @@ typedef struct HEIFGrid {
 } HEIFGrid;
 
 typedef struct MOVContext {
-    const AVClass *class; ///< class for private options
+    const AVClass *clazz; ///< class for private options
     AVFormatContext *fc;
     int time_scale;
     int64_t duration;     ///< duration of the longest track
diff --git a/libavutil/cpu.c b/libavutil/cpu.c
index 07b90aa90a..19d1324fda 100644
--- a/libavutil/cpu.c
+++ b/libavutil/cpu.c
@@ -307,9 +307,9 @@ size_t av_cpu_max_align(void)
 #if !ARCH_X86
 unsigned long ff_getauxval(unsigned long type)
 {
-#if HAVE_GETAUXVAL
-    return getauxval(type);
-#elif HAVE_ELF_AUX_INFO
+// #if HAVE_GETAUXVAL
+//     return getauxval(type);
+#if HAVE_ELF_AUX_INFO
     unsigned long aux = 0;
     int ret = elf_aux_info(type, &aux, sizeof(aux));
     if (ret != 0) {
-- 
2.55.0

